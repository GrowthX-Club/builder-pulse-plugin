{
  "description": "Minimal builder state telemetry. Raw prompts, prompt lengths, commands, paths, source code, and tool I/O are never persisted or sent; only state changes and 15-minute heartbeats are queued.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Shell|Exec|exec_command|write_stdin|apply_patch|Edit|Write|NotebookEdit|Task|update_plan|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}
