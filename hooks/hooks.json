{
  "description": "Builder progress and learning-feedback telemetry. Primary UserPromptSubmit text is secret-redacted, UTF-8 bounded, and sent through a separate retry queue; separate command, path, source, transcript, assistant-response, and tool-I/O hook fields are never sent. Due lifecycle events may include five cumulative numeric Codex token counters; subagent and fork capture stays off.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Shell|Exec|exec_command|write_stdin|apply_patch|Edit|Write|NotebookEdit|Task|update_plan|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/builder_pulse.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\builder_pulse.py\" hook",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}
