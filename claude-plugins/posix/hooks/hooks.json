{
  "description": "Builder progress and learning-feedback telemetry for explicitly enrolled project folders only. Claude Code prompts are secret-redacted and UTF-8 bounded. Commands, paths, files, tool I/O, assistant replies, transcripts, environment variables, token counts, subagents, and forks are never sent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_pulse_claude.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_pulse_claude.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Shell|Exec|exec_command|write_stdin|apply_patch|Edit|Write|NotebookEdit|Task|update_plan|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_pulse_claude.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_pulse_claude.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_pulse_claude.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
